<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>Bắn rời tay chân - iOS</title>
<style>
  * {
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
  }
  html, body {
    margin: 0;
    height: 100%;
    overflow: hidden;
    background: #1a1a2e;
    touch-action: manipulation;      /* chặn double-tap zoom */
    overscroll-behavior: none;        /* chặn bounce scroll iOS */
    display: flex;
    justify-content: center;
    align-items: center;
    font-family: -apple-system, sans-serif;
  }
  #stage {
    position: relative;
    width: 300px;
    height: 400px;
    /* scale vừa màn hình nhỏ */
    transform-origin: center;
  }
  .part {
    position: absolute;
    will-change: transform, opacity;  /* tăng tốc GPU trên iOS */
    transition: transform 1.2s cubic-bezier(.3,.8,.5,1), opacity 1.2s;
    -webkit-backface-visibility: hidden;
  }
  #head {
    width: 90px; height: 90px;
    background: #ffd7a8;
    border-radius: 50%;
    left: 105px; top: 20px;
    border: 4px solid #b9805a;
    box-sizing: border-box;
    z-index: 10;
  }
  #head::before {
    content: ""; position: absolute;
    width: 14px; height: 14px; background: #222;
    border-radius: 50%; left: 20px; top: 30px;
  }
  #head::after {
    content: ""; position: absolute;
    width: 14px; height: 14px; background: #222;
    border-radius: 50%; right: 20px; top: 30px;
  }
  .eye-mouth {
    position: absolute; width: 40px; height: 18px;
    border-bottom: 5px solid #b9805a;
    border-radius: 0 0 40px 40px;
    left: 25px; top: 50px;
  }
  #body {
    width: 90px; height: 140px;
    background: #4a90e2;
    border-radius: 18px;
    left: 105px; top: 110px;
    border: 4px solid #2c5f9e;
    box-sizing: border-box;
  }
  .arm {
    width: 28px; height: 110px;
    background: #ffd7a8;
    border-radius: 14px;
    border: 4px solid #b9805a;
    box-sizing: border-box;
  }
  #armL { left: 65px; top: 120px; }
  #armR { left: 207px; top: 120px; }
  .leg {
    width: 32px; height: 130px;
    background: #333;
    border-radius: 16px;
    border: 4px solid #111;
    box-sizing: border-box;
  }
  #legL { left: 110px; top: 250px; }
  #legR { left: 158px; top: 250px; }

  #hint {
    position: fixed;
    top: calc(env(safe-area-inset-top, 0px) + 16px);  /* né tai thỏ */
    left: 50%; transform: translateX(-50%);
    color: #fff; font-size: 14px;
    background: rgba(0,0,0,.6);
    padding: 8px 18px; border-radius: 20px;
    pointer-events: none;
    white-space: nowrap;
  }
  #reset {
    position: fixed;
    bottom: calc(env(safe-area-inset-bottom, 0px) + 20px); /* né home bar */
    left: 50%; transform: translateX(-50%);
    padding: 12px 28px;
    font-size: 16px;
    border: none;
    border-radius: 24px;
    background: #e94560;
    color: #fff;
    font-weight: 600;
    -webkit-appearance: none;
    appearance: none;
    box-shadow: 0 4px 12px rgba(233,69,96,.4);
  }
  #reset:active { transform: translateX(-50%) scale(.94); }
</style>
</head>
<body>

<div id="hint">👆 Chạm vào tay / chân / thân để bắn bay!</div>

<div id="stage">
  <div id="head" class="part"><div class="eye-mouth"></div></div>
  <div id="body" class="part"></div>
  <div id="armL" class="part arm"></div>
  <div id="armR" class="part arm"></div>
  <div id="legL" class="part leg"></div>
  <div id="legR" class="part leg"></div>
</div>

<button id="reset">🔄 Hồi sinh</button>

<script>
(function () {
  'use strict';

  const stage = document.getElementById('stage');
  const head  = document.getElementById('head');
  const parts = document.querySelectorAll('.part');

  // ---- Tự scale vừa màn hình iPhone ----
  function fitStage() {
    const maxW = window.innerWidth  * 0.95;
    const maxH = window.innerHeight * 0.75;
    const s = Math.min(maxW / 300, maxH / 400, 1.2);
    stage.style.transform = `scale(${s})`;
  }
  fitStage();
  window.addEventListener('resize', fitStage);
  window.addEventListener('orientationchange', () => setTimeout(fitStage, 200));

  // ---- Chống double-tap zoom (iOS cũ vẫn cần) ----
  let lastTouch = 0;
  document.addEventListener('touchend', (e) => {
    const now = Date.now();
    if (now - lastTouch < 300) e.preventDefault();
    lastTouch = now;
  }, { passive: false });

  // ---- Bay ----
  function randomFly(el) {
    const angle = Math.random() * Math.PI * 2;
    const dist  = 250 + Math.random() * 350;
    const x = Math.cos(angle) * dist;
    const y = Math.sin(angle) * dist - 150;
    const rot = (Math.random() - 0.5) * 1440;
    el.style.transform = `translate(${x}px, ${y}px) rotate(${rot}deg)`;
    el.style.opacity = '0';
    el.dataset.dead = '1';
  }

  // ---- Rung nhẹ kiểu iOS khi trúng (nếu hỗ trợ) ----
  function haptic() {
    if (navigator.vibrate) navigator.vibrate(15);
  }

  // ---- Xử lý chạm: dùng pointerdown (iOS 13+ hỗ trợ tốt) ----
  function handleTap(el, e) {
    e.preventDefault();
    e.stopPropagation();

    if (el.id === 'head') {
      // Đầu lắc nhẹ tại chỗ
      if (head.animate) {
        head.animate(
          [{ transform: 'rotate(0deg)' },
           { transform: 'rotate(-8deg)' },
           { transform: 'rotate(8deg)' },
           { transform: 'rotate(0deg)' }],
          { duration: 300, easing: 'ease-out' }
        );
      }
      haptic();
      return;
    }

    if (el.dataset.dead) return;
    randomFly(el);
    haptic();
  }

  parts.forEach(part => {
    // pointerdown: bắt ngay, không delay trên iOS
    part.addEventListener('pointerdown', (e) => handleTap(part, e));
    // fallback cho iOS rất cũ
    if (!window.PointerEvent) {
      part.addEventListener('touchstart', (e) => handleTap(part, e), { passive: false });
    }
  });

  // ---- Hồi sinh ----
  document.getElementById('reset').addEventListener('pointerdown', (e) => {
    e.preventDefault();
    parts.forEach(p => {
      p.style.transform = '';
      p.style.opacity = '1';
      delete p.dataset.dead;
    });
    haptic();
  });

  // ---- Chặn iOS kéo trang / pinch zoom ----
  document.addEventListener('gesturestart', e => e.preventDefault());
  document.addEventListener('touchmove', e => {
    if (e.touches.length > 1) e.preventDefault();
  }, { passive: false });

})();
</script>
</body>
</html>
